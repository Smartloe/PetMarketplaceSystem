# Copy to .env and fill in. .env is gitignored; this template is committed.
#
#   cp .env.template .env
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ---- Django core ----
# Required when DJANGO_DEBUG=False; with DEBUG on an insecure dev fallback is used.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Database ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pet_shop
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- CORS / CSRF ----
# Comma-separated origin allowlists. Must include the frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# ---- AI pet advisor (LongCat) ----
# Without a key, /api/ai/consult/ returns 503.
LONGCAT_API_KEY=
# Optional override of the upstream endpoint.
# LONGCAT_API_URL=https://api.longcat.chat/openai/v1/chat/completions

# ---- JWT lifetimes ----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- Rate limits (DRF throttle rates) ----
THROTTLE_AI_CONSULT=10/min
THROTTLE_CAPTCHA=30/min
THROTTLE_LOGIN=10/min

# ---- Cache ----
# LocMemCache is per-process and will break captcha validation across
# multiple workers. Use Redis in any multi-process deployment.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# ---- Product preview limit for anonymous users ----
COMMODITY_PREVIEW_LIMIT=6

# ---- RAG 知识库 / embedding ----
# 知识库检索用的向量化服务。SiliconFlow 兼容 OpenAI 的 /v1/embeddings 格式。
# 注意：上传到知识库的文档内容会发送到这个服务做向量化。
SILICONFLOW_API_KEY=
# 默认 Qwen3-Embedding-0.6B：1024 维，中文检索区分度实测优于 bge-m3 和
# bge-large-zh，且比 8B 版本（4096 维）成本低得多。
# 换模型必须同时改 EMBEDDING_DIM，并重新向量化全部知识库分片 ——
# 不同模型的向量空间不通用，混用会让检索结果失效。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings

# ---- Production-only hardening (ignored while DEBUG=True) ----
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
